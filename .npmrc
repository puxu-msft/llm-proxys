# Always install devDependencies in this repo, even when the shell (or CI) exports
# NODE_ENV=production, which npm otherwise turns into `omit=dev`. `include=dev` forces
# `omit=[]`, so the on-demand dev tooling — eslint, tailwind, playwright-core — stays
# available locally.
include=dev
# Docker is unaffected: the builder copies only package.json before running `npm install`,
# so this file is not present at that step (and the builder installs dev deps regardless).
